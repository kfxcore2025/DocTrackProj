@model List<DocTrackProj.Models.AdminDocument>
@{
    ViewData["Title"] = "History Logs";
    var notifications = ViewBag.Notifications as List<DocTrackProj.Models.AdminDocument>;
    var pendingCount = ViewBag.PendingDocuments ?? 0;
    var forSignatureCount = ViewBag.ForSignatureDocuments ?? 0;
}

<link rel="stylesheet" href="~/css/historylogs.css" asp-append-version="true" />

<div class="admin-layout">

    <!-- SIDEBAR -->
    <partial name="_AdminSidebar" />

    <!-- MAIN CONTENT -->
    <main class="main-content">

        <header class="top-header">
            <div>
                <h1>History Logs</h1>
                <p>@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</p>
            </div>

            <partial name="_Notification"/>
        </header>

        <div class="history-content">

            <div class="history-header">
                <h2>History Logs</h2>
                <div class="viewing-badge">Viewing: All Documents</div>
            </div>

            <!-- SEARCH -->
            <div class="search-box">
                <span class="search-icon">🔍</span>
                <input type="text" id="searchInput" placeholder="Search by tracking code, name, status..." onkeyup="filterTable()" />
            </div>

            <!-- TABLE -->
            <div class="documents-card">
                <div class="table-container">
                    <table id="historyTable">
                        <thead>
                            <tr>
                                <th>TRACKING CODE</th>
                                <th>DOCUMENT NAME</th>
                                <th>FROM</th>
                                <th>TO</th>
                                <th>REASON</th>
                                <th>STATUS</th>
                                <th>DATE & TIME</th>
                                <th>ACTION</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var doc in Model)
                                {
                                    <tr>
                                        <td class="tracking-code">@doc.TrackingCode</td>
                                        <td>@doc.DocumentName</td>
                                        <td>@(doc.FromOffice?.OfficeName ?? "—")</td>
                                        <td>@(doc.ToOffice?.OfficeName ?? "—")</td>
                                        <td>@(string.IsNullOrEmpty(doc.Reason) ? "—" : doc.Reason)</td>
                                        <td>
                                            @if (doc.Status == "Pending")
                                            {
                                                <span class="status pending">● Pending</span>
                                            }
                                            else if (doc.Status == "Received")
                                            {
                                                <span class="status received">● Received</span>
                                            }
                                            else
                                            {
                                                <span class="status">● @doc.Status</span>
                                            }
                                        </td>
                                        <td>@doc.DateSubmitted.ToString("MMM dd, yyyy hh:mm tt")</td>
                                        <td>
                                            <a href="/Admin/DocumentDetails/@doc.Id" class="view-btn">View</a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="no-documents">
                                        <div class="empty-state">
                                            <div class="empty-icon">📭</div>
                                            <strong>No documents found</strong>
                                            <span>There are currently no documents in the system.</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="table-footer">
                    Showing @(Model?.Count ?? 0) of @(Model?.Count ?? 0) records
                </div>
            </div>

        </div>
    </main>
</div>

<script>
    // Search Filter
    function filterTable() {
        const input = document.getElementById("searchInput");
        const filter = input.value.toUpperCase();
        const table = document.getElementById("historyTable");
        const tr = table.getElementsByTagName("tr");

        for (let i = 1; i < tr.length; i++) {
            let found = false;
            const td = tr[i].getElementsByTagName("td");

            for (let j = 0; j < td.length; j++) {
                if (td[j]) {
                    const txtValue = td[j].textContent || td[j].innerText;
                    if (txtValue.toUpperCase().indexOf(filter) > -1) {
                        found = true;
                        break;
                    }
                }
            }

            tr[i].style.display = found ? "" : "none";
        }
    }
</script>