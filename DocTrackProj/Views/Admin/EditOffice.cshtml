@model DocTrackProj.Models.Office
@{
    ViewData["Title"] = "Edit Office";
}
<link rel="stylesheet" href="~/css/manage.css" asp-append-version="true" />

<div class="main-content">
    <div class="page-header"><h1>Edit Office</h1></div>

    <div class="card" style="max-width:500px;">
        <form asp-action="EditOffice" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="OfficeName"></label>
                <input asp-for="OfficeName" class="form-control" />
                <span asp-validation-for="OfficeName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="RoomNumber"></label>
                <input asp-for="RoomNumber" class="form-control" />
            </div>

            <div class="form-group">
                <label>
                    <input asp-for="IsActive" type="checkbox" /> Active
                </label>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-primary">Save Changes</button>
                <a href="/Admin/Manage" class="btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>