@{
    var notifications = ViewBag.Notifications as List<DocTrackProj.Models.UserDocument>;
    var notificationCount = ViewBag.NotificationCount ?? 0;
}

<link rel="stylesheet" href="~/css/notification.css" asp-append-version="true" />

<div class="notification-wrapper">
    <button type="button" class="notification" id="notificationButton">
        🔔
        @if (notificationCount > 0)
        {
            <span class="notification-count">@notificationCount</span>
        }
    </button>

    <div class="notification-popup" id="notificationPopup">
        <div class="notification-header">
            <h3>Notifications</h3>
            <span>@notificationCount</span>
        </div>

        <div class="notification-list">
            @if (notifications != null && notifications.Any())
            {
                foreach (var notification in notifications)
                {
                    <a href="/User/Receive" class="notification-item">
                        <div class="notification-icon">📥</div>
                        <div class="notification-text">
                            <strong>New Document to Receive</strong>
                            <p>@notification.DocumentName is waiting to be received.</p>
                            <small>@notification.DateSubmitted.ToString("MMM dd, yyyy hh:mm tt")</small>
                        </div>
                    </a>
                }
            }
            else
            {
                <div class="no-notifications">
                    <div>🎉</div>
                    <p>No new notifications</p>
                </div>
            }
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const btn = document.getElementById("notificationButton");
        const popup = document.getElementById("notificationPopup");
        const countBadge = document.querySelector(".notification-count");
        const currentCount = Number("@notificationCount") || 0;

        const lastSeenCount = parseInt(localStorage.getItem("userLastSeenNotificationCount") || "0");

        if (countBadge) {
            countBadge.style.display = currentCount > lastSeenCount ? "flex" : "none";
        }

        if (btn && popup) {
            btn.addEventListener("click", function (e) {
                e.stopPropagation();
                popup.classList.toggle("show");

                if (popup.classList.contains("show")) {
                    localStorage.setItem("userLastSeenNotificationCount", currentCount);
                    if (countBadge) countBadge.style.display = "none";
                }
            });

            document.addEventListener("click", function (e) {
                if (!popup.contains(e.target) && !btn.contains(e.target)) {
                    popup.classList.remove("show");
                }
            });
        }
    });
</script>