@{
    ViewData["Title"] = "Sign Up - CTU DocTrack";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Sign Up - CTU DocTrack</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: #0f1229;
            background: radial-gradient(1200px 600px at 50% -20%, #1a237e 0%, #0f1229 60%);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            font-family: 'Inter', sans-serif;
        }

        .auth-card {
            background: linear-gradient(180deg, #1a1f4b 0%, #121633 100%);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 24px;
            padding: 28px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.5);
        }

        .tab-bar {
            background: rgba(0,0,0,0.3);
            border-radius: 16px;
            padding: 6px;
            display: flex;
            gap: 6px;
            margin-bottom: 24px;
        }

            .tab-bar a, .tab-bar button {
                flex: 1;
                padding: 10px;
                border-radius: 12px;
                text-align: center;
                text-decoration: none;
                color: #8a8fb5;
                background: transparent;
                border: none;
                font-weight: 600;
                font-size: 14px;
            }

            .tab-bar .active {
                background: white;
                color: #121633;
            }

        .auth-card h2 {
            color: white;
            font-weight: 800;
            margin: 0;
        }

        .auth-card p.subtitle {
            color: #8a8fb5;
            font-size: 13px;
            margin-top: 6px;
            margin-bottom: 20px;
        }

        label {
            color: #c2c6e0;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 6px;
            display: block;
        }

        .form-control-dark {
            width: 100%;
            background: #151a36;
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 12px;
            padding: 12px 14px;
            color: white;
            outline: none;
        }

            .form-control-dark:focus {
                border-color: #5a5cff;
                background: #1a1f42;
            }

            .form-control-dark::placeholder {
                color: #6b7194;
            }

        select.form-control-dark option {
            background: #151a36;
            color: white;
        }

        .hint {
            color: #6b7194;
            font-size: 11px;
            margin-top: 4px;
        }

        .btn-primary-dark {
            background: #5a5cff;
            border: none;
            border-radius: 12px;
            padding: 13px;
            width: 100%;
            color: white;
            font-weight: 700;
            margin-top: 10px;
        }

            .btn-primary-dark:hover {
                background: #4a4aff;
            }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="tab-bar">
            <a asp-action="Login">Sign In</a>
            <button class="active">Sign Up</button>
            <a href="#">Forgot?</a>
        </div>

        <h2>Sign Up</h2>
        <p class="subtitle">Position is what you are in your office/dept.</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 small">@ViewBag.Error</div>
        }

        <form asp-action="Register" method="post">
            <div class="mb-3">
                <label>Full Name</label>
                <input name="fullName" class="form-control-dark" placeholder="Juan Dela Cruz" required />
            </div>

            <div class="mb-3">
                <label>Email Address</label>
                <input name="email" id="emailInput" type="email" class="form-control-dark" placeholder="you@ctu.edu.ph" required />
                <div class="d-flex gap-2 mt-2">
                    <input name="otpCode" id="otpCode" class="form-control-dark" placeholder="6-digit code" maxlength="6" style="flex:1" required />
                    <button type="button" id="sendOtpBtn" class="btn btn-outline-light btn-sm" style="border-radius:10px; white-space:nowrap;">Send Code</button>
                </div>
                <small id="otpMsg" class="hint"></small>
            </div>

            <div class="mb-3">
                <label>Position in Office / Department</label>
                <input name="position" class="form-control-dark" placeholder="Ex: Clerk, Secretary, BSIT Student, Accounting Staff" required />
                <div class="hint">Just type your position — no options</div>
            </div>

            <div class="mb-3">
                <label>Office / Department (@(ViewBag.Offices != null ? (ViewBag.Offices as List<DocTrackProj.Models.Office>).Count + " offices" : "loading..."))</label>
                <select name="officeId" id="officeId" class="form-control-dark" required>
                    <option value="">Select Office</option>
                    @if (ViewBag.Offices != null)
                    {
                        foreach (var office in ViewBag.Offices as List<DocTrackProj.Models.Office>)
                        {
                            <option value="@office.Id">@office.OfficeName - Room @office.RoomNumber</option>
                        }
                    }
                </select>
            </div>

            <div class="mb-3 position-relative">
                <label>Password</label>
                <input name="password" type="password" id="passInput" class="form-control-dark" placeholder="Min 6 chars" required />
            </div>

            <button type="submit" class="btn-primary-dark">Create Account →</button>
        </form>
    </div>

    <script>
        document.getElementById('sendOtpBtn').addEventListener('click', async () => {
            const email = document.getElementById('emailInput').value;
            const msg = document.getElementById('otpMsg');
            const btn = document.getElementById('sendOtpBtn');
            if(!email){ msg.textContent = 'Enter email first'; msg.style.color='#ff6b6b'; return; }
            btn.disabled = true; btn.textContent = 'Sending...';
            msg.textContent = 'Sending code...'; msg.style.color='#8a8fb5';
            try {
                const res = await fetch('@Url.Action("SendOtp", "Account")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email })
                });
                const data = await res.json();
                msg.textContent = data.message;
                msg.style.color = data.success ? '#4ade80' : '#ff6b6b';
                if(data.success){
                    let sec = 60;
                    const timer = setInterval(()=> {
                        btn.textContent = sec + 's'; sec--;
                        if(sec < 0){ clearInterval(timer); btn.disabled=false; btn.textContent='Resend Code'; }
                    },1000);
                } else {
                    btn.disabled=false; btn.textContent='Send Code';
                }
            } catch(e){ msg.textContent = 'Error sending'; msg.style.color='#ff6b6b'; btn.disabled=false; }
        });
    </script>
</body>
</html>